# Copy this file to .env.local for local development, or set
# VITE_API_BASE_URL as a build-time environment variable in whatever
# platform builds/hosts the frontend (Render Static Site, Vercel, Netlify).
#
# Leave empty (or omit the file) to use same-origin "/api" requests via
# the Vite dev server proxy in vite.config.js -- that only works when
# the backend is reachable at http://127.0.0.1:8000 during local dev.
#
# Once deployed, this must point at the backend's public URL, with no
# trailing slash:
VITE_API_BASE_URL=https://your-backend.onrender.com
